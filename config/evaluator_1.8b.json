{
    "train_data_path":"./resources/real_persona_chat.csv",
    "instruction_path":"./resources/instruction_informativeness.txt",
    "model":"llm-jp/llm-jp-3-1.8b-instruct",
    "output_dir":"./checkpoints/mlp",
    "num_train_epochs":3,
    "per_device_train_batch_size":4,
    "logging_dir":"./checkpoints/mlp/logs",
    "logging_steps":200,
    "save_steps":2000,
    "save_strategy":"epoch",
    "eval_strategy":"epoch",
    "eval_steps":20,
    "save_total_limit":10,
    "learning_rate":1e-4,
    "warmup_steps":500,
    "weight_decay":0.01,
    "gradient_accumulation_steps":1,
    "remove_unused_columns":true,
    "bf16":true,
    "group_by_length":true,
    "overwrite_output_dir":true,
    "run_name":"rpc_evaluator_1.8b_informativeness",
    "report_to":"wandb",
    "lora_r":64,
    "lora_alpha":16,
    "lora_dropout":0.05,
    "lora_bias":"none",
    "target_modules":["q_proj", "o_proj", "gate_proj", "up_proj", "down_proj", "k_proj", "v_proj"]
}